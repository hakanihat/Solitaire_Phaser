{
  "name": "solitaire-collection",
  "version": "2.0.0",
  "description": "A collection of solitaire games built with Phaser 3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "serve": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc",
    "lint": "eslint src scripts tests --ext .ts",
    "format": "prettier -w src scripts tests",
    "format:check": "prettier --check src scripts tests",
    "deals": "tsx scripts/generate-deals.ts",
    "benchmark": "tsx scripts/benchmark.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vite-plugin-static-copy": "^1.0.6",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@capacitor/android": "^5.5.0",
    "@capacitor/app": "^5.0.6",
    "@capacitor/cli": "^5.5.1",
    "@capacitor/core": "^5.5.1",
    "phaser": "^3.90.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
